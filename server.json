require('dotenv').config();
const WebSocket = require('ws');
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const path = require('path');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: '*' },
  transports: ['websocket', 'polling']
});

const PORT = process.env.PORT || 3000;
const APP_ID = 1089;
const DERIV_TOKEN = process.env.DERIV_TOKEN || '';

const SYMBOL = 'R_100';

// 🔥 MARTINGALE SETTINGS
const MARTINGALE_STEPS = [1, 2, 4, 8, 16];
const MAX_STEPS = MARTINGALE_STEPS.length;
const TP_TARGET = 5.0;

// 🕒 SESSION CONTROL
const START_HOUR = 10;
const START_MINUTE = 0;
const TRADE_WINDOW_MINUTES = 30;

// 🔄 COOLDOWN AFTER LOSS
let cooldown = 0;

let hasTradedToday = false;
let lastTradeDay = null;

let state = {
  running: false,
  inTrade: false,
  pnl: 0,

  wins: 0,
  losses: 0,

  stepIndex: 0,
  stake: MARTINGALE_STEPS[0],

  history: [],
  statsBuffer: [],
  quote: null,
  lastDigit: null,
  pipSize: 2,

  symbol: SYMBOL,
  cooldown: 0,

  session: {
    startHour: START_HOUR,
    startMinute: START_MINUTE,
    windowMinutes: TRADE_WINDOW_MINUTES,
    withinWindow: false,
    canTradeNow: false,
    hasTradedToday: false,
    label: `${String(START_HOUR).padStart(2, '0')}:${String(START_MINUTE).padStart(2, '0')} - ${String(START_HOUR).padStart(2, '0')}:${String(START_MINUTE + TRADE_WINDOW_MINUTES).padStart(2, '0')}`
  }
};

let derivWs = null;
let pendingProposal = null;

function round2(v) {
  return Math.round(v * 100) / 100;
}

function emitState() {
  refreshRuntimeState();
  io.emit('update', state);
}

function pushLog(message, level = 'info') {
  io.emit('log', {
    ts: new Date().toISOString(),
    level,
    message
  });
}

function getLastDigit(price, pipSize) {
  const factor = Math.pow(10, pipSize);
  return Math.round(price * factor) % 10;
}

function getDigitPercent(digit) {
  const counts = Array(10).fill(0);
  state.statsBuffer.forEach((d) => counts[d]++);
  const total = state.statsBuffer.length || 1;
  return (counts[digit] / total) * 100;
}

function getSessionSnapshot() {
  const now = new Date();

  const currentDay = now.toDateString();
  const hours = now.getHours();
  const minutes = now.getMinutes();

  if (lastTradeDay !== currentDay) {
    hasTradedToday = false;
    lastTradeDay = currentDay;
  }

  const currentTotalMinutes = hours * 60 + minutes;
  const startTotalMinutes = START_HOUR * 60 + START_MINUTE;
  const endTotalMinutes = startTotalMinutes + TRADE_WINDOW_MINUTES;

  const withinWindow =
    currentTotalMinutes >= startTotalMinutes &&
    currentTotalMinutes < endTotalMinutes;

  return {
    startHour: START_HOUR,
    startMinute: START_MINUTE,
    windowMinutes: TRADE_WINDOW_MINUTES,
    withinWindow,
    canTradeNow: !hasTradedToday && withinWindow,
    hasTradedToday,
    label: `${String(START_HOUR).padStart(2, '0')}:${String(START_MINUTE).padStart(2, '0')} - ${String(Math.floor(endTotalMinutes / 60)).padStart(2, '0')}:${String(endTotalMinutes % 60).padStart(2, '0')}`
  };
}

function refreshRuntimeState() {
  state.cooldown = cooldown;
  state.session = getSessionSnapshot();
  state.symbol = SYMBOL;
}

function connect() {
  derivWs = new WebSocket(`wss://ws.derivws.com/websockets/v3?app_id=${APP_ID}`);

  derivWs.on('open', () => {
    pushLog('Connected to Deriv socket', 'success');
    derivWs.send(JSON.stringify({ authorize: DERIV_TOKEN }));
  });

  derivWs.on('message', (raw) => {
    let data;
    try {
      data = JSON.parse(raw);
    } catch {
      return;
    }

    if (data.error) {
      pushLog(`${data.error.message || 'Deriv error'}`, 'error');
      return;
    }

    if (data.msg_type === 'authorize') {
      derivWs.send(JSON.stringify({ active_symbols: 'brief' }));
    }

    else if (data.msg_type === 'active_symbols') {
      derivWs.send(JSON.stringify({ ticks: SYMBOL, subscribe: 1 }));
      state.running = true;
      pushLog(`Bot started on ${SYMBOL}`, 'success');
      emitState();
    }

    else if (data.msg_type === 'tick') {
      const digit = getLastDigit(data.tick.quote, state.pipSize);

      state.quote = data.tick.quote;
      state.lastDigit = digit;

      state.statsBuffer.push(digit);
      if (state.statsBuffer.length > 100) state.statsBuffer.shift();

      state.history.push(digit);
      if (state.history.length > 6) state.history.shift();

      refreshRuntimeState();

      if (cooldown > 0) {
        cooldown--;
        refreshRuntimeState();
        emitState();
        return;
      }

      const pct0 = getDigitPercent(0);
      const pct1 = getDigitPercent(1);

      const validEntry =
        !state.inTrade &&
        state.statsBuffer.length >= 100 &&
        (digit === 0 || digit === 1) &&
        pct0 < 10.5 &&
        pct1 < 10.5;

      if (state.running && validEntry && state.session.canTradeNow) {
        pushLog(
          `ENTRY → Digit ${digit} | %0:${pct0.toFixed(2)} %1:${pct1.toFixed(2)} | Stake $${state.stake.toFixed(2)}`,
          'info'
        );

        state.inTrade = true;
        hasTradedToday = true;
        refreshRuntimeState();
        emitState();

        requestProposal();
        return;
      }

      emitState();
    }

    else if (data.msg_type === 'proposal') {
      if (!state.inTrade) return;

      pendingProposal = data.proposal.id;

      derivWs.send(
        JSON.stringify({
          buy: pendingProposal,
          price: state.stake
        })
      );
    }

    else if (data.msg_type === 'buy') {
      pushLog(`BUY placed | Contract ${data.buy.contract_id} | Stake $${state.stake.toFixed(2)}`, 'info');

      derivWs.send(
        JSON.stringify({
          proposal_open_contract: 1,
          contract_id: data.buy.contract_id,
          subscribe: 1
        })
      );
    }

    else if (data.msg_type === 'proposal_open_contract') {
      const c = data.proposal_open_contract;
      if (!c.is_sold) return;

      const profit = parseFloat(c.profit);

      state.pnl = round2(state.pnl + profit);
      state.inTrade = false;

      if (state.pnl >= TP_TARGET) {
        pushLog(`TP HIT +${state.pnl.toFixed(2)} → STOP BOT`, 'success');
        state.running = false;
      }

      if (profit > 0) {
        state.wins++;
        state.stepIndex = 0;
        state.stake = MARTINGALE_STEPS[0];

        pushLog(`WIN +${profit.toFixed(2)} → Reset to Step 1`, 'success');
      } else {
        state.losses++;
        state.stepIndex++;
        cooldown = 3;

        pushLog(`LOSS ${profit.toFixed(2)} → Cooldown 3 ticks`, 'warn');

        if (state.stepIndex >= MAX_STEPS) {
          pushLog('MAX MARTINGALE STEPS HIT → STOP BOT', 'error');
          state.running = false;
        } else {
          state.stake = MARTINGALE_STEPS[state.stepIndex];
          pushLog(`Next stake → $${state.stake.toFixed(2)} | Step ${state.stepIndex + 1}/${MAX_STEPS}`, 'warn');
        }
      }

      refreshRuntimeState();
      emitState();
    }
  });

  derivWs.on('close', () => {
    state.running = false;
    state.inTrade = false;
    refreshRuntimeState();
    emitState();

    pushLog('Socket closed → reconnecting in 5s', 'warn');
    setTimeout(connect, 5000);
  });

  derivWs.on('error', () => {
    pushLog('WebSocket connection error', 'error');
  });
}

function requestProposal() {
  derivWs.send(
    JSON.stringify({
      proposal: 1,
      amount: round2(state.stake),
      basis: 'stake',
      contract_type: 'DIGITOVER',
      currency: 'USD',
      duration: 1,
      duration_unit: 't',
      symbol: SYMBOL,
      barrier: '1'
    })
  );
}

io.on('connection', (socket) => {
  refreshRuntimeState();
  socket.emit('update', state);
  socket.emit('log', {
    ts: new Date().toISOString(),
    level: 'info',
    message: 'Dashboard connected'
  });
});

app.use(express.static(path.join(__dirname, 'public')));

server.listen(PORT, () => {
  console.log(`Server running on ${PORT}`);
  connect();
});
